{
  "version": "1.0",
  "portionPolicy": {
    "catalogFirst": true,
    "aiEstimateWhenCatalogMissing": true,
    "defaultNaturalUnitCount": 1,
    "defaultNaturalUnitSize": "medium",
    "autoApplyCatalog": true,
    "autoApplyAiConfidence": [
      "high",
      "medium"
    ],
    "maxAiRelativeRange": 0.55,
    "neverAutoApplyKinds": [
      "dish",
      "plate",
      "bowl",
      "serving",
      "pizza",
      "slice_variable",
      "piece_variable",
      "unknown"
    ],
    "showAssumption": true
  },
  "ambiguityPolicy": {
    "askOnlyIfMaterial": true
  }
}
